#Ασκηση 2 υπολογισμος τοκων αρχικου κεφαλαιου   
Κεφάλαιο=int(input("Δώσε το αρχικό κεφάλαιο: "))
Επιτόκιο=int(input("Δώσε το ποσοστό επιτoκίου %: "))
Χρόνια=int(input("Δώσε τα χρόνια παρακράτησης: "))
Τοκος=Κεφάλαιο*(1+Επιτόκιο)^Χρόνια - Κεφάλαιο
print('---Υπολογισμός Τόκου---')   
print("Αρχικό Κεφάλαιο:", Κεφάλαιο)
print("Επιτόκιο:", Επιτόκιο , '%')
print("Χρόνια:", Χρόνια)
print("Τόκος:", Τοκος)
print("Συνολικό Ποσό:", Κεφάλαιο + Τοκος)
print('-------------------------')